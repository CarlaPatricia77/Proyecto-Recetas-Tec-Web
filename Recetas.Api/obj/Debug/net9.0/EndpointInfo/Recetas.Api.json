{
  "openapi": "3.0.4",
  "info": {
    "title": "API de Recetas",
    "description": "API para gestión de recetas, usuarios y categorías",
    "contact": {
      "name": "Equipo de Desarrollo",
      "email": "desarrollo@recetas.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/Receta": {
      "get": {
        "tags": [
          "Receta"
        ],
        "summary": "Obtiene todas las recetas con filtros opcionales y paginación.",
        "parameters": [
          {
            "name": "UsuarioId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "CategoriaId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Busqueda",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "TiempoMaximo",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Ingrediente",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retorna la lista de recetas"
          },
          "400": {
            "description": "Solicitud incorrecta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      },
      "post": {
        "tags": [
          "Receta"
        ],
        "summary": "Crea una nueva receta.",
        "requestBody": {
          "description": "Datos de la receta",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/RecetaDto"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecetaDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RecetaDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RecetaDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Receta creada exitosamente"
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Receta/{id}": {
      "get": {
        "tags": [
          "Receta"
        ],
        "summary": "Obtiene una receta por su ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID de la receta",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
