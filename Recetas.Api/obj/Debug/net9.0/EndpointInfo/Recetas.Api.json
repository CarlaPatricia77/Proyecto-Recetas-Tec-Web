              "schema": {
                "$ref": "#/components/schemas/RecetaDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RecetaDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RecetaDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Receta actualizada exitosamente"
          },
          "400": {
            "description": "Id no coincide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Receta no encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Receta"
        ],
        "summary": "Elimina una receta por su ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID de la receta",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Receta eliminada exitosamente"
          },
          "404": {
            "description": "Receta no encontrada",
